PORT=4000

# Local dev (matches docker-compose.yml). Replace with your Neon/Supabase/Render
# connection string in production.
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/mini_erp?schema=public"

# Required — the server refuses to start without this. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
